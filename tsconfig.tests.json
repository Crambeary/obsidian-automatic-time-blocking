{
  "compilerOptions": {
    "target": "es2019",
    "module": "commonjs",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "forceConsistentCasingInFileNames": true,
    "rootDir": ".",
    "outDir": ".tmp-tests"
  },
  "include": ["src/**/*.ts", "types.d.ts", "tests/**/*.js"]
}
